{
  "case_id": "c056_report_that_knew_too_much",
  "accepted_conclusions": {
    "h_adnan": {
      "grade": 0,
      "note_ar": "يصدّق التقرير كما نُشر، وتنقضه ورقة عدنان الموقّعة والمحضر وإعادة الجمع."
    },
    "h_maysoon": {
      "grade": 0,
      "note_ar": "يرى اختلاقاً، وتنقضه نسخة الملف التي فُتح رابطها في غرفة النشرة قبل النشر؛ تبقى لها مسؤولية عن عدم المقابلة."
    },
    "h_wasim": {
      "grade": 1,
      "note_ar": "استنتاج متسق مع الأدلة ويتطلب ذكر حدوده."
    },
    "h_sources": {
      "grade": 0,
      "note_ar": "يفترض أن المصدرين عرفا ما لم يقولاه، ولا يفسر غياب طريقهما إلى القاعة وأوراقها."
    },
    "h_judge": {
      "grade": 0,
      "note_ar": "يتهم عضواً بالتسريب، ولا يفسر أن الرقمين المنشورين ليسا في أي ورقة موقّعة ولا أن الرابط فُتح قبل زيارة حازم."
    }
  },
