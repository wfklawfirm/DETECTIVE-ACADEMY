  "premise": {
    "hook_ar": "وجد أمين نادي الحديقة ورقة وصية ملصقة داخل غطاء علبة بذور قديمة، وفيها عبارة واحدة تحتمل معنيين. وقبل أن تجتمع اللجنة، يطالب بها ثلاثة أعضاء كل واحد بقراءته. فأي القراءات تسندها الأوراق؟",
    "player_role_ar": "أنت عضو في لجنة الشباب بنادي الحديقة المشتركة، وطلب منك الأستاذ جلال رأياً معلّلاً قبل اجتماع اللجنة، دون أن تنحاز لأحد أو تتهم أحداً.",
    "setting_ar": "نادي الحديقة المشتركة في حيّ التلّ الأخضر بمدينة مرفأ الصنوبر المتخيَّلة، يوم السبت. الأسماء والتواريخ متخيَّلة، والوصية غير مالية: عهدة دفاتر ومفتاح بيت زجاجي لزراعة الشتلات. الأوقات بساعة النادي.",
    "public_fact_ids": [
      "f_will_found",
      "f_claim_made",
      "f_candidates"
    ],
    "assumed_general_knowledge_ar": [
      "اللفظ الواحد قد يحمل معنيين، والنص وحده لا يحسم أيهما أراد كاتبه",
      "المصطلح في وثائق جهةٍ ما يُفهم بتعريف تلك الجهة له، ما لم يظهر ما يدل على غير ذلك",
      "الكاتب يستعمل ألفاظه عادة بالمعنى الذي استعملها به في كتاباته الأخرى",
      "لقب المجاملة في حفل لا يُعدّ تعريفاً رسمياً لكلمة في وثيقة"
    ]
  },
