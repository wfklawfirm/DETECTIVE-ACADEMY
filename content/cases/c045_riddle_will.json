  "ending_explanation": {
    "steps": [
      {
        "order": 1,
        "text_ar": "قبل الحكم عدّد القراءات: «الأقدم» قد تعني الأكبر سناً (هشام)، أو الأطول خدمة بلا انقطاع (نادية)، أو الأسبق انضماماً (طارق). الوصية نفسها تقول إن للكلمة وجهين وتحيل إلى أوراق النادي.",
        "uses_evidence_ids": [
          "ev_will"
        ],
        "inference_id": "i_est_card"
      },
      {
        "order": 2,
        "text_ar": "المسار الأول، من جهة النادي: الأقدمية في نظامه برقم البطاقة، ولا يسقط الرقم بالغياب، وأصغر الأرقام 3 لطارق.",
        "uses_evidence_ids": [
          "ev_bylaws",
          "ev_register"
        ],
        "inference_id": "i_formal"
      },
      {
        "order": 3,
        "text_ar": "المسار الثاني، من جهة الكاتبة ولا يمر بالنظام ولا بالسجل: في نشرة 2018 سمّت طارق «أقدم» وسمّت يوسف «أكبر سناً»، وفي ورقة 2025 تركت المفتاح عند «أقدمنا طارق».",
        "uses_evidence_ids": [
          "ev_newsletter",
          "ev_memo"
        ],
        "inference_id": "i_author"
      },
      {
        "order": 4,
        "text_ar": "قراءة هشام تخلط الأقدمية بالعمر؛ والكاتبة تفرّق بينهما، ولقب «كبيرنا» مزاح في حفل لا يعرّف كلمة مكتوبة.",
        "uses_evidence_ids": [
          "ev_hisham",
          "ev_register",
          "ev_newsletter"
        ],
        "inference_id": "i_rule_age"
      },
      {
        "order": 5,
        "text_ar": "قراءة نادية تخلط الأقدمية بالاستمرار؛ والمادة الثامنة لا تُسقط الرقم بالغياب، والكاتبة سمّت طارق «أقدم» وهو غائب.",
        "uses_evidence_ids": [
          "ev_nadia",
          "ev_bylaws",
          "ev_memo"
        ],
        "inference_id": "i_rule_cont"
      },
      {
        "order": 6,
        "text_ar": "الخلاصة: الغموض لم يمنع الترجيح. القراءة الأقرب إلى النظام وإلى لفظ الكاتبة هي طارق، والمطالبان الآخران صادقان في قراءتيهما لكن الأوراق لا تسندهما.",
        "uses_evidence_ids": [
          "ev_bylaws",
          "ev_memo"
        ],
        "inference_id": "i_rule_open"
      }
    ],
    "alternative_paths_ar": [
      "يكفي مسار النظام والسجل وحده لترجيح طارق، ويكفي مسار نشرة 2018 وورقة 2025 وحده؛ والأقوى أن يتفقا لأن كلاً منهما لا يعتمد على الآخر."
    ],
    "what_evidence_could_not_show_ar": [
      "لا نعرف مراد الأستاذة سلوى بيقين، فنحن نرجّح أقرب القراءات إلى استعمالها.",
      "المادة السابعة وُضعت لترتيب الكلام والتصويت، لا للوصايا.",
      "قد توجد أوراق أخرى لم تصل إلينا، ولو ظهرت ورقة لاحقة بخط الأستاذة تسمّي غير طارق لوجب أن نراجع الاستنتاج.",
      "لا نعرف لماذا أخفت الأستاذة الوصية في علبة البذور، ولا حاجة لذلك في الحل."
    ],
    "science_notes_ar": [
      "الكلمة التي تحتمل معنيين لا تُحسم بالأقرب إلى الحرف ولا بالأعلى صوتاً؛ تُحسم بمعناها عند كاتبها وفي وثائق الجهة التي كُتبت لها.",
      "حين نعرض القراءات الممكنة كلها قبل الاختيار، نتجنب أن نتمسك بأول معنى خطر ببالنا.",
      "مسار الإثبات الأقوى هو الذي يعتمد على وثائق مستقلة تتفق، لا على وثيقة واحدة نكررها.",
      "صدق صاحب القراءة لا يجعل قراءته صحيحة، وكذلك حرارة دفاعه عنها."
    ]
  },
