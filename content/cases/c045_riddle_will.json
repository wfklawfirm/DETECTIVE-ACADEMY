  "evidence": [
    {
      "id": "ev_will",
      "title_ar": "ورقة الوصية في غطاء علبة البذور",
      "kind": "documentary",
      "content_ar": "علبة البذور الصفراء عليها ملصق بخط الأستاذة سلوى: «بذور الشتاء، خريف 2025». وداخل الغطاء ورقة ملصقة بشريط، بخط اليد نفسه:\n\n«إلى أصدقاء حديقتنا،\nلا أملك مالاً أتركه، وأملك شيئين أحبهما: دفاتر البذور التي دوّنتها سنين، ومفتاح البيت الزجاجي.\nأوصي بهما لأقدم أعضاء النادي، يحفظهما ويعلّم بهما من جاء بعده.\nوللكلمة وجهان، فمن أراد عدلاً فليعد إلى أوراق النادي وليترك ظنّ المجالس.\nسلوى»",
      "acquired_by_action_ids": [
        "a_read_will"
      ],
      "supports_fact_ids": [
        "f_will_found"
      ],
      "reliability": "moderate",
      "limits_ar": "تثبت لفظ الوصية فحسب، ولا تعرّف «الأقدم»؛ وتفتح الباب لأكثر من قراءة ولا تحسم بينها.",
      "location_id": "loc_clubroom"
    },
