  "ending_explanation": {
    "steps": [
      {
        "order": 1,
        "text_ar": "ابدأ بالقيود المعلنة: الظرف يتعيّن بباقي القسمة على 5، لا بلمس الأظرف ولا باختيارها بالنظر. وبين 1 و9 خمسة أعداد متتالية، فكل عدد منها يعطي باقياً مختلفاً؛ ومن يقول عدده الأخير يستطيع أن يصل إلى أي باقٍ من 1 إلى 5.",
        "uses_evidence_ids": [
          "ev_rules"
        ],
        "inference_id": "i_force"
      },
      {
        "order": 2,
        "text_ar": "في لوح القرعة كان لايث الخامس والأخير. المجموع قبله 27، وباقيه 2. الباقي 4 يحتاج عدداً باقيه 2، وقد قال 7: 27 + 7 = 34، و6 × 5 = 30، والباقي 4، وهو ما كتبه صباحاً.",
        "uses_evidence_ids": [
          "ev_log"
        ],
        "inference_id": "i_steer_a"
      },
      {
        "order": 3,
        "text_ar": "المسار الثاني لا يعتمد على اللوح: في الجلسة التجريبية أخطأ توقع لايث حين تكلم ثالثاً وأصاب حين تكلم آخراً، وسجل الوصول يبيّن أنه وصل بعد الجميع يوم القرعة.",
        "uses_evidence_ids": [
          "ev_practice",
          "ev_arrival"
        ],
        "inference_id": "i_steer_b"
      },
      {
        "order": 4,
        "text_ar": "نقطتا الحبر على ظرفين لا ظرف واحد، ولا شأن للمس الأظرف بالنتيجة؛ فالفرضية القائلة بعلامة تسقط.",
        "uses_evidence_ids": [
          "ev_envelopes",
          "ev_rules"
        ],
        "inference_id": "i_rule_marked"
      },
      {
        "order": 5,
        "text_ar": "حديث لايث ونبيل قرب الباب لا يبيّن مضمونه، والنتيجة كانت ستتحقق مهما قال الأربعة الأوائل؛ فلا حاجة إلى معاون.",
        "uses_evidence_ids": [
          "ev_whisper",
          "ev_log"
        ],
        "inference_id": "i_rule_helper"
      },
      {
        "order": 6,
        "text_ar": "الخلاصة: التوقع المختوم صحيح لأن لايث ضبط عدده الأخير على الباقي المطلوب، لا لأنه عرف المستقبل.",
        "uses_evidence_ids": [
          "ev_log",
          "ev_jar"
        ],
        "inference_id": "i_est_last"
      }
    ],
    "alternative_paths_ar": [
      "يكفي لوح القرعة مع بطاقة القواعد لإثبات الحل حساباً، ويكفي سجل الجلسة التجريبية مع سجل الوصول لإثباته بالمقارنة؛ والأقوى أن يتفق المساران."
    ],
    "what_evidence_could_not_show_ar": [
      "لا نعرف إن كان تأخر لايث عن الوصول مقصوداً، والمشرفة تذكر له سبباً عادياً.",
      "التجربة جولتان فقط، فلا تثبت قاعدة وحدها.",
      "لا يمكن نفي الصدفة نفياً مطلقاً، لكن الحساب يفسّر النتيجة بلا حاجة إليها.",
      "لا نعرف ما قاله لايث ونبيل قرب الباب، ولا حاجة إلى معرفته في هذا الحل."
    ],
    "science_notes_ar": [
      "باقي القسمة على 5 يأخذ خمس قيم فقط، ولذلك تغطيها كلها خمسة أعداد متتالية.",
      "القاعدة التي تجعل آخر المتكلمين يتحكم في الناتج تُسمى هنا ثغرة في تصميم القرعة، لا خرقاً لقواعدها المعلنة.",
      "عند الحيرة من حدث يبدو مستحيلاً، اجمع القيود المعلنة أولاً، ثم اختبر كل تفسير منافس بسؤال: ما الذي كان سيحدث لو تغير شيء آخر؟",
      "اكتشاف طريقة تتيح لأحد أن يتحكم في النتيجة لا يثبت وحده سوء نيته؛ والحكم على النية يحتاج دليلاً آخر."
    ]
  },
