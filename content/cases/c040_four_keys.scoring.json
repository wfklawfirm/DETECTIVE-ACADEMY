    "h_hala": {
      "grade": 0,
      "note_ar": "يعدّ اسم البطاقة في السجل دليلاً على حاملها، وتنقضه وثيقة الحفل ودفتر الاستقبال."
    },
    "h_rana": {
      "grade": 0,
      "note_ar": "يبني على مذكرة قديمة ورأي، ويتجاهل أن المزلاج بقي مغلقاً والحرارة ثابتة بعد خروجها."
    },
    "h_shadi": {
      "grade": 0,
      "note_ar": "يقرأ دخوله المتأخر دون مقارنته بوقت التنبيه الذي سبقه."
    },
    "h_majed": {
      "grade": 1,
      "note_ar": "استنتاج متسق مع الأدلة ويتطلب ذكر حدوده، فالسجلات لا تثبت النية ولا طريقة أخذ البطاقة."
    },
    "h_karim": {
      "grade": 0,
      "note_ar": "لا يحسب زمن المشي بين الحاجز والغرفة مقابل توقيعي الإيصال."
    },
    "h_glitch": {
      "grade": 0,
      "note_ar": "يفترض عطلاً دون أن يلاحظ اتفاق ثلاثة أجهزة سليمة."
    }
  },
