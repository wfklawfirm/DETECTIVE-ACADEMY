{
  "name": "athar",
  "version": "0.1.0",
  "private": true,
  "description": "ATHAR | أَثَر — Arabic-first interactive mystery & investigative learning platform (pilot-ready vertical slice)",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "setup": "tsx scripts/setup.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "check:cases": "tsx scripts/check-cases.ts",
    "check:library": "bash scripts/check-library.sh",
    "check:leaks": "tsx scripts/leak-scan.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check:cases && npm test"
  },
  "dependencies": {
    "@fontsource/amiri": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans-arabic": "5.2.8",
    "@fontsource/reem-kufi": "5.2.8",
    "@libsql/client": "0.15.15",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
