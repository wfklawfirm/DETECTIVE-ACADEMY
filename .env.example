# ATHAR environment (copy to .env.local)
# 32+ char random secret used to sign device-state tokens and sessions
ATHAR_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# libSQL database. Local file for dev; a hosted libSQL/Turso URL for production
ATHAR_DB_URL=file:./data/athar.db
ATHAR_DB_AUTH_TOKEN=
# First-run admin bootstrap (created once if no admin exists)
ATHAR_ADMIN_EMAIL=admin@athar.local
ATHAR_ADMIN_PASSWORD=
# Show cases whose reviews are not yet approved, with a visible PREVIEW banner (never enable for a public launch)
ATHAR_ALLOW_PREVIEW=true
# AI dialogue provider: "local" (rule-based, default) — no external model is wired in this build
ATHAR_AI_PROVIDER=local
